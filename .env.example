# Storage
S3_BUCKET_NAME=replace-with-your-s3-bucket
AWS_DEFAULT_REGION=us-east-1

# Optional local test storage
STORAGE_BACKEND=nosql
NOSQL_DB_PATH=local_test_store.json

# Ollama routing
OLLAMA_URL=http://127.0.0.1:11434
# For Docker deployment on Linux host, use: http://host.docker.internal:11434
OLLAMA_GENERATE_PATH=/api/generate
OLLAMA_MODEL_ASK=llama3.2:1b
OLLAMA_MODEL_ANALYZE=llava
OLLAMA_TIMEOUT_SECONDS=60
